      "parameters": {
        "jsCode": "// Devuelve los fragmentos recuperados con su seccion y su distancia,\n// para que el gate pueda comprobar de donde salieron y con cuanta conviccion.\nconst r = $input.all().map((i) => i.json);\nreturn [{ json: {\n  pregunta: $('Webhook Buscar').first().json.body.pregunta,\n  resultados: r.map((x) => ({\n    seccion: x.document?.metadata?.seccion ?? null,\n    subseccion: x.document?.metadata?.subseccion || null,\n    documento: x.document?.metadata?.documento ?? null,\n    distancia: x.score,\n    // El fragmento va COMPLETO: recortarlo hacia un gate que busca palabras clave\n    // produce fallos falsos cuando la palabra queda mas alla del recorte.\n    texto: x.document?.pageContent ?? '',\n  })),\n} }];"
      },
