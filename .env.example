# Copia a .env. Nunca se commitea.
N8N_BASE_URL=                 # URL base del despliegue (viene en el correo de entrega); basta para tests/humo_chat.mjs
# --- Solo para operar el despliegue (autor) ---
N8N_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
HEB_INGESTA_URL=
HEB_INGESTA_TOKEN=
HEB_LECTOR_PASSWORD=
HEB_PG_HOST=bano_postgres
HEB_PG_DB=bano
HEB_PG_USER=heb_lector
HEB_CRED_ID=
VPS_HOST=
VPS_KEY=
# --- Canal Telegram ---
TELEGRAM_BOT_TOKEN=            # BotFather
TELEGRAM_USER_IDS=             # allowlist, ids separados por coma
TELEGRAM_SAL=                  # sal del hash de chat_id (openssl rand -hex 16)
TELEGRAM_CRED_ID=              # id de la credencial telegramApi en n8n (la crea infra/crear-telegram.mjs)
